# Build LocalSend for Mac OS 9 with MPW (MrC + PPCLink + Rez).# In MPW: set the directory to the project folder, then run   Execute :os9:build.mpw# Needs Apple's Universal Interfaces and Libraries (they come with MPW).Set Exit 0Set Src ":src:"Set Os9 ":os9:"Set Out ":build_os9:"NewFolder {Out}Set Exit 1Echo "Setting file types..."SetFile -t TEXT -c 'MPS ' {Src}ls.c {Src}ls.h {Src}ls_json.c {Src}ls_json.h {Src}ls_compat.c {Src}ls_compat.h ¶	{Src}ls_tls.c {Src}ls_tls.h {Src}ls_plat.h {Os9}plat_os9.c {Os9}plat_os9.h {Os9}os9_app.c {Os9}localsend.r ¶	":assets:os9:localsend_icons.r"Set Flags "-opt speed -typecheck relaxed -w off -d LS_NO_VSNPRINTF -d LS_OS9 -i {Src} -i {Os9}"Echo "Compiling..."MrC {Src}ls.c {Flags} -o {Out}ls.c.xMrC {Src}ls_json.c {Flags} -o {Out}ls_json.c.xMrC {Src}ls_compat.c {Flags} -o {Out}ls_compat.c.xMrC {Src}ls_tls.c {Flags} -o {Out}ls_tls.c.xMrC {Os9}plat_os9.c {Flags} -o {Out}plat_os9.c.xMrC {Os9}os9_app.c {Flags} -o {Out}os9_app.c.xEcho "Linking..."PPCLink -o LocalSend -t 'APPL' -c 'LSPC' ¶	{Out}ls.c.x {Out}ls_json.c.x {Out}ls_compat.c.x {Out}ls_tls.c.x ¶	{Out}plat_os9.c.x {Out}os9_app.c.x ¶	"{PPCLibraries}"PPCCRuntime.o ¶	"{PPCLibraries}"StdCRuntime.o ¶	"{PPCLibraries}"OpenTransportAppPPC.o ¶	"{PPCLibraries}"OpenTptInetPPC.o ¶	"{SharedLibraries}"InterfaceLib ¶	"{SharedLibraries}"StdCLib ¶	"{SharedLibraries}"MathLib ¶	"{SharedLibraries}"ThreadsLib ¶	"{SharedLibraries}"OpenTransportLib ¶	"{SharedLibraries}"OpenTptInternetLibEcho "Adding resources..."Rez -a -t 'APPL' -c 'LSPC' -i {Os9} -i ":assets:os9:" {Os9}localsend.r -o LocalSendEcho "Done: LocalSend"